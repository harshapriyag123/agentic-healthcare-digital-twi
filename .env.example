# Safe local backend defaults. Copy to .env; never commit the resulting file.
APP_ENV=local
APP_VERSION=0.1.0-local
COMMIT_SHA=unknown
BUILD_TIMESTAMP=unknown
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BODY_BYTES=1048576
OTEL_ENABLED=false
OTEL_SERVICE_NAME=geotwin-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=deployment.name=local-compose
# Server-side secret in hosted environments; intentionally empty here.
OTEL_EXPORTER_OTLP_HEADERS=
