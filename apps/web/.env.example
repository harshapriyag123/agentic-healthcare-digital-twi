# Browser-public values only. Do not place OTLP headers or provider secrets here.
VITE_APP_ENV=local
VITE_APP_VERSION=0.1.0-local
VITE_DEPLOYMENT_NAME=GeoTwin Sentinel Local
# Empty in local mode uses the Vite /api development proxy.
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Complete authenticated SigNoz Community application embedded by the Observability tab.
VITE_SIGNOZ_APP_URL=http://localhost:3301
# SigNoz trace-detail template. Change the origin for a remote deployment.
VITE_SIGNOZ_DASHBOARD_URL=http://localhost:3301/trace/{traceId}
